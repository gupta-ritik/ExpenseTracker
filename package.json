{
  "name": "expense-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:test:migrate": "tsx scripts/migrate-test.ts",
    "db:backfill-categories": "tsx scripts/backfill-categories.ts",
    "fixtures:pdf": "tsx scripts/make-pdf-fixtures.ts",
    "test:groq": "vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.28",
    "@better-auth/expo": "^1.7.28",
    "@fontsource/archivo-black": "^5.2.0",
    "@fontsource/jetbrains-mono": "^5.2.0",
    "@hookform/resolvers": "^5.9.2",
    "@neon/config": "^1.14.7",
    "@neon/env": "^2.1.10",
    "@radix-ui/react-dialog": "^1.3.1",
    "@vercel/functions": "^3.11.3",
    "better-auth": "^1.7.28",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "imapflow": "^2.12.2",
    "lucide-react": "^1.80.0",
    "mailparser": "^3.15.0",
    "next": "^15.5.0",
    "papaparse": "^5.7.1",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.92.0",
    "react-is": "^19.0.0",
    "recharts": "^3.11.1",
    "unpdf": "^2.2.2",
    "zod": "^4.6.7",
    "@expense-tracker/shared": "0.1.0"
  },
  "devDependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "@eslint/eslintrc": "^3.3.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.0",
    "husky": "^9.1.0",
    "lint-staged": "^16.0.0",
    "postcss": "^8",
    "prettier": "3.3.3",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22.12"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{css,json,md}": "prettier --write"
  },
  "workspaces": [
    "packages/*",
    "mobile"
  ]
}
